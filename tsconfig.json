{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    // The examples import the package by name; here that is this repository's source.
    "paths": { "better-auth-scim-provisioning": ["./src/index.ts"] }
  },
  "include": ["src", "test"],
  "exclude": ["test/types"]
}
